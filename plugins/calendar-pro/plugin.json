{
  "id": "com.cellsflux.calendar-pro",
  "name": "Calendar Pro",
  "version": "1.0.0",
  "description": "Un calendrier interactif React pour Fluxplugin, permettant de consulter les dates et d'ajouter des événements.",
  "author": "Cellsflux",
  "license": "MIT",
  "repository": "https://github.com/cellsflux/fluxplugin-plugin",
  "icon": "./assets/icon.svg",
  "readme": "./README.md",
  "categories": ["Productivity"],
  "keywords": ["calendar", "react", "events", "fullcalendar", "demo"],
  "links": {},
  "renderer": "./dist/renderer.js",
  "styles": ["./dist/index.css", "./dist/renderer.css"],
  "activationEvents": ["onCommand:calendar_pro.hello"],
  "permissions": ["commands", "routes", "menus", "ui", "styles", "events"],
  "engines": {
    "fluxplugin": "^1.0.0"
  },
  "contributes": {
    "commands": [
      {
        "id": "calendar_pro.hello",
        "title": "Calendar Pro: Say hello"
      }
    ]
  }
}
